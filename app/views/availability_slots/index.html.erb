<div class="section-heading"><h1>My availability</h1><%= link_to "Add time", new_availability_slot_path, class: "button small" %></div><table><thead><tr><th>Day</th><th>From</th><th>Until</th><th></th></tr></thead><tbody><% @slots.each do |slot| %><tr><td><%= Date::DAYNAMES[slot.day_of_week] %></td><td><%= slot.starts_at.strftime("%H:%M") %></td><td><%= slot.ends_at.strftime("%H:%M") %></td><td><%= link_to "Edit", edit_availability_slot_path(slot) %> · <%= button_to "Remove", slot, method: :delete, class: "link-button danger" %></td></tr><% end %></tbody></table>
