<%= form_with model: @slot, class: "form" do |f| %><%= render "shared/errors", object: @slot %><%= f.label :day_of_week, "Day" %><%= f.select :day_of_week, Date::DAYNAMES.each_with_index.map { |name, i| [name, i] } %><%= f.label :starts_at, "Start time" %><%= f.time_field :starts_at %><%= f.label :ends_at, "End time" %><%= f.time_field :ends_at %><%= f.submit class: "button" %><% end %>
