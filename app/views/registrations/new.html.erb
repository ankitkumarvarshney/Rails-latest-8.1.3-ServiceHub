<div class="auth"><h1>Create your account</h1><%= form_with model: @user, url: registrations_path, class: "form" do |f| %><%= render "shared/errors", object: @user %><%= f.label :name %><%= f.text_field :name %><%= f.label :email %><%= f.email_field :email %><%= f.label :password %><%= f.password_field :password %><%= f.label :password_confirmation %><%= f.password_field :password_confirmation %><%= f.label :role, "I want to" %><%= f.select :role, [["Book services", "customer"], ["Offer services", "provider"]] %><%= f.submit "Create account", class: "button" %><% end %></div>
