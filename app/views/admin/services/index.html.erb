<h1>Services</h1><table><thead><tr><th>Service</th><th>Provider</th><th>Category</th><th>Status</th></tr></thead><tbody><% @services.each do |service| %><tr><td><%= service.name %></td><td><%= service.provider_profile.business_name %></td><td><%= service.category.name %></td><td><%= form_with model: [:admin, service] do |f| %><%= f.select :status, Service.statuses.keys %><%= f.submit "Save", class: "link-button" %><% end %></td></tr><% end %></tbody></table>
