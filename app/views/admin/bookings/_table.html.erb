<table><thead><tr><th>Service</th><th>Customer</th><th>Provider</th><th>When</th><th>Status</th></tr></thead><tbody><% bookings.each do |booking| %><tr><td><%= booking.service.name %></td><td><%= booking.user.name %></td><td><%= booking.provider_profile.business_name %></td><td><%= l booking.start_time, format: :short %></td><td><span class="status <%= booking.status %>"><%= booking.status %></span></td></tr><% end %></tbody></table>
