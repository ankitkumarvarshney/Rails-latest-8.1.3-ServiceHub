<h1>Users</h1><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead><tbody><% @users.each do |user| %><tr><td><%= user.name %></td><td><%= user.email %></td><td><%= form_with model: [:admin, user] do |f| %><%= f.select :role, User.roles.keys %><%= f.submit "Save", class: "link-button" %><% end %></td><td><%= user.created_at.to_date %></td></tr><% end %></tbody></table>
