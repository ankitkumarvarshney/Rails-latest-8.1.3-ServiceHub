<h1><%= provider? ? "Booking requests" : "My bookings" %></h1><div class="booking-list"><% @bookings.each do |booking| %><article class="booking"><div><span class="status <%= booking.status %>"><%= booking.status %></span><h3><%= booking.service.name %></h3><p><%= l booking.start_time, format: :long %> · <%= booking.service.duration %> min</p><p><%= provider? ? booking.user.name : booking.provider_profile.business_name %></p></div><div class="actions"><%= link_to "Details", booking %><% if provider? && booking.pending? %><%= button_to "Confirm", confirm_booking_path(booking), method: :patch, class: "button small" %><%= button_to "Reject", cancel_booking_path(booking), method: :patch, class: "link-button danger" %><% elsif provider? && booking.confirmed? %><%= button_to "Mark completed", complete_booking_path(booking), method: :patch, class: "button small" %><% elsif !provider? && booking.completed? && !booking.review %><%= link_to "Leave review", new_review_path(booking_id: booking.id), class: "button small" %><% elsif !booking.cancelled? %><%= button_to "Cancel", cancel_booking_path(booking), method: :patch, class: "link-button danger" %><% end %></div></article><% end %></div>
