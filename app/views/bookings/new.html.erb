<h1>Book <%= @service.name %></h1><p><%= @service.duration %> minutes · <%= number_to_currency @service.price %></p><%= form_with model: @booking, url: bookings_path(service_id: @service.id), class: "form" do |f| %><%= render "shared/errors", object: @booking %><%= f.label :start_time, "Choose date and time" %><%= f.datetime_local_field :start_time, min: Time.current.strftime("%Y-%m-%dT%H:%M") %><%= f.label :customer_note, "A note for the provider (optional)" %><%= f.text_area :customer_note %><%= f.submit "Request booking", class: "button" %><% end %>
