<h1><%= @booking.service.name %></h1><p class="status <%= @booking.status %>"><%= @booking.status %></p><div class="detail"><div><p><strong>When:</strong> <%= l @booking.start_time, format: :long %> to <%= l @booking.end_time, format: :time %></p><p><strong>Customer:</strong> <%= @booking.user.name %></p><p><strong>Provider:</strong> <%= @booking.provider_profile.business_name %></p><p><strong>Note:</strong> <%= @booking.customer_note.presence || "—" %></p></div></div>
