<div class="detail"><div><p class="eyebrow"><%= @service.category.name %></p><h1><%= @service.name %></h1><p class="lead"><%= @service.description %></p><p>Provided by <strong><%= @service.provider_profile.business_name %></strong> · ★ <%= @service.average_rating %> service rating · ★ <%= @service.provider_profile.average_rating %> provider rating</p></div><aside class="booking-box"><strong><%= number_to_currency @service.price %></strong><span><%= @service.duration %> minutes</span><% if signed_in? && current_user.customer? %><%= link_to "Book this service", new_booking_path(service_id: @service.id), class: "button full" %><% else %><%= link_to "Sign in to book", new_session_path, class: "button full" %><% end %></aside></div>
<% if provider? && @service.provider_profile == current_user.provider_profile %><p><%= link_to "Edit service", edit_service_path(@service) %> · <%= button_to "Delete", @service, method: :delete, class: "inline-danger" %></p><% end %>
