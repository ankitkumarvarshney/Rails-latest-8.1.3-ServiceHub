<%= form_with model: @service, class: "form" do |f| %><%= render "shared/errors", object: @service %><%= f.label :name %><%= f.text_field :name %><%= f.label :description %><%= f.text_area :description %><%= f.label :category_id, "Category" %><%= f.collection_select :category_id, Category.order(:name), :id, :name, prompt: "Choose a category" %><div class="form-row"><div><%= f.label :price %><%= f.number_field :price, step: 0.01 %></div><div><%= f.label :duration, "Duration (minutes)" %><%= f.number_field :duration %></div></div><%= f.label :status %><%= f.select :status, Service.statuses.keys %><%= f.submit class: "button" %><% end %>
