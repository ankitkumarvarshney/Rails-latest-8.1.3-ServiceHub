<h1>Review <%= @booking.service.name %></h1><%= form_with model: @review, class: "form" do |f| %><%= render "shared/errors", object: @review %><%= f.hidden_field :booking_id, value: @booking.id %><%= f.label :rating %><%= f.select :rating, (1..5).map { |n| ["#{n} star#{'s' if n > 1}", n] } %><%= f.label :comment %><%= f.text_area :comment, placeholder: "Tell others about your experience" %><%= f.submit "Publish review", class: "button" %><% end %>
