<div class="section-heading"><h1>Notifications</h1><%= button_to "Mark all read", mark_all_read_notifications_path, method: :patch, class: "link-button" %></div><% @notifications.each do |notification| %><article class="notification <%= 'unread' unless notification.read_at %>"><strong><%= notification.title %></strong><p><%= notification.body %></p><small><%= time_ago_in_words(notification.created_at) %> ago</small></article><% end %>
